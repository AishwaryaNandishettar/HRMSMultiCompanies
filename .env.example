# ========================================
# HRMS Backend Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# For production deployment (Railway/Render), 
# set these in your platform's environment settings

# ========================================
# FRONTEND URL
# ========================================
# For localhost development
# FRONTEND_URL=http://localhost:5173

# For Vercel production deployment
# FRONTEND_URL=https://your-hrms-app.vercel.app

FRONTEND_URL=http://localhost:5173

# ========================================
# DATABASE
# ========================================
# For localhost MongoDB
# MONGODB_URI=mongodb://localhost:27017/Data_base_hrms

# For MongoDB Atlas (Production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hrms_db

MONGODB_URI=mongodb+srv://hrms_user:HRMS%4012345@cluster0.aexpf8t.mongodb.net/Data_base_hrms?retryWrites=true&w=majority&appName=Cluster0

# ========================================
# EMAIL CONFIGURATION
# ========================================

# Email Service Provider Selection
# Set to 'gmail' for Gmail SMTP (testing only)
# Set to 'resend' for Resend API (recommended for production)
EMAIL_SERVICE_PROVIDER=resend

# ----------------------------------------
# RESEND EMAIL CONFIGURATION (RECOMMENDED)
# ----------------------------------------
# Get your Resend API key from: https://resend.com/api-keys
# Create a free account at https://resend.com

RESEND_ENABLED=true
RESEND_API_KEY=re_YourApiKeyHere_ChangeThis
RESEND_FROM_EMAIL=noreply@omoikaneinnovations.com
RESEND_FROM_NAME=HRMS System

# ----------------------------------------
# GMAIL SMTP CONFIGURATION (TESTING ONLY)
# ⚠️ NOT RECOMMENDED FOR PRODUCTION
# ----------------------------------------
# Get Gmail App Password from: https://myaccount.google.com/apppasswords
# Note: Requires 2-Factor Authentication enabled on Gmail

GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here
MAIL_FROM_NAME=HRMS System


# ========================================
# JWT CONFIGURATION
# ========================================
# Change this to a strong secret in production
# Generate with: openssl rand -base64 32

JWT_SECRET=MyFixedSecretKey123456
JWT_EXPIRATION=86400

# ========================================
# SERVER PORT
# ========================================
SERVER_PORT=8082
