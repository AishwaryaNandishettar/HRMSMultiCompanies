# ========================================
# HRMS Backend Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# For production deployment (Railway/Render), 
# set these in your platform's environment settings

# ========================================
# FRONTEND URL
# ========================================
# For localhost development
# FRONTEND_URL=http://localhost:5173

# For Vercel production deployment
# FRONTEND_URL=https://your-hrms-app.vercel.app

FRONTEND_URL=http://localhost:5173

# ========================================
# DATABASE
# ========================================
# For localhost MongoDB
# MONGODB_URI=mongodb://localhost:27017/Data_base_hrms

# For MongoDB Atlas (Production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hrms_db

MONGODB_URI=mongodb+srv://hrms_user:HRMS%4012345@cluster0.aexpf8t.mongodb.net/Data_base_hrms?retryWrites=true&w=majority&appName=Cluster0

# ========================================
# EMAIL CONFIGURATION (Gmail)
# ========================================
# Use Gmail app password (not your regular password)
# How to get app password:
# 1. Enable 2-Step Verification in Gmail
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate app password for "Mail"

# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password

# ========================================
# JWT CONFIGURATION
# ========================================
# Change this to a strong secret in production
# Generate with: openssl rand -base64 32

JWT_SECRET=MyFixedSecretKey123456
JWT_EXPIRATION=86400

# ========================================
# SERVER PORT
# ========================================
SERVER_PORT=8082
